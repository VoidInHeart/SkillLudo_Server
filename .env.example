# Never commit a real password. Use local .env or a deployment secret store.
SKILLLUDO_DB_HOST=127.0.0.1
SKILLLUDO_DB_PORT=3306
SKILLLUDO_DB_NAME=skill_ludo
SKILLLUDO_DB_USER=skillludo_app
SKILLLUDO_DB_PASSWORD=replace-with-a-local-secret
# Optional; unset disables submissions. Production reads smtp-credentials Secret.
# SMTP_AUTH_CODE=replace-with-your-smtp-authorization-code

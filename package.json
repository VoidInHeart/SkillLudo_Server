{
  "name": "skill-ludo-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative WebSocket server for the SkillLudo four-player game.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "contract:sync": "node scripts/sync-client-contract.mjs",
    "contract:check": "node scripts/sync-client-contract.mjs --check",
    "verify:server": "tsx scripts/preview-server.ts",
    "verify:skill-fixtures": "tsx scripts/export-skill-fixtures.ts",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-database.mjs"
  },
  "dependencies": {
    "mysql2": "^3.23.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
